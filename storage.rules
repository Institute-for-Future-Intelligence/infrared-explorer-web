rules_version = '2';

// Infrared Explorer — Storage security rules.
// Storage rules can only see request.auth.uid (Firebase UID), NOT the mongoId claim,
// so user-scoped paths (thumbnails) are keyed by authUid. See docs/telelab-migration.md §5.
// DEPLOY NOTE: export the current live rules first as a baseline before tightening, so
// existing showcase playback / thumbnails don't 403.

service firebase.storage {
  match /b/{bucket}/o {

    // Showcase media — public, read-only.
    match /videostore/{file=**} {
      allow read: if true;
      allow write: if false;
    }

    // Recording frames (data_N.png/.dat) — the live source for every recording-sourced
    // experiment. Public read: recording-sourced experiments can be featured as public
    // showcases on the homepage and must be viewable anonymously (the experiment metadata
    // stays access-controlled in Firestore; frame ids are unguessable 24-hex).
    //
    // CREATE-ONLY writes let the mobile capture app (infrared-explorer-app) upload new
    // recordings while keeping existing/curated showcase frames immutable: `resource == null`
    // means a caller can only create a frame that doesn't exist yet — never overwrite or
    // delete one. recId is an unguessable client-minted UUID; frames are size- and
    // contentType-capped (.dat = application/octet-stream, .png = image/png). Any signed-in
    // user may create; ownership/quota/abuse control is deferred to a `createRecordingUpload`
    // callable (signed-URL minting) as the hardening step before broad student rollout, at
    // which point this reverts to write:false. See the app repo:
    // docs/cloud-classroom-integration.md §6.
    match /recordings/{recId}/{file=**} {
      allow read: if true;
      allow create: if request.auth != null
                    && resource == null
                    && request.resource.size < 5 * 1024 * 1024
                    && request.resource.contentType in ['application/octet-stream', 'image/png'];
      allow update, delete: if false;
    }

    // Per-user clip thumbnails (only when canvas capture is enabled; pointer-to-frame is default).
    match /thumbnails/{uid}/{file=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 2 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
