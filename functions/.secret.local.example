# =============================================================================
# 云函数本地密钥模板 —— 仅在你要用「Functions 模拟器」跑后端时才需要。
# 复制为 functions/.secret.local 并填入真实值(向项目管理员索取)。
# 这些是真正的机密,.secret.local 已被 gitignore,切勿提交。
#
# 生产环境的这些值存放在 Firebase Secret Manager,由已部署的函数读取,
# 本文件只服务于本地模拟器。
# =============================================================================

# 调用 Claude / DeepSeek 生成报告、Q&A、Lab Assistant 用的 API Key
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# 「联系我们」邮件发送用的 SMTP 账号(Gmail / service@intofuture.org)
# 注意:Gmail 需使用「应用专用密码」,普通密码会 535 认证失败。
SMTP_USER=
SMTP_PASS=
