# =============================================================================
# 前端环境变量模板 —— 复制为 .env 即可(Windows: Copy-Item .env.example .env)
# =============================================================================
# 下面这组 VITE_FIREBASE_* 是 Firebase 的「Web 应用配置」。它们会随打包后的
# 前端一起公开发布,本来就能在浏览器里看到,不是机密,可以直接照抄使用。
# 真正的访问控制靠 Firestore/Storage 安全规则,而不是靠隐藏这些值。

VITE_FIREBASE_API_KEY = "AIzaSyCYbjhyEy9JOrHYVt-43Gj5oQQ9HIsgTyI"
VITE_FIREBASE_AUTH_DOMAIN = "infrared-explorer.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID = "infrared-explorer"
VITE_FIREBASE_STORAGE_BUCKET = "infrared-explorer.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID = "482530289615"
VITE_FIREBASE_APP_ID = "1:482530289615:web:6fb29813458e7c9f80d4ba"
VITE_FIREBASE_MEASUREMENT_ID = "G-1EP8H4WQ8Z"

# 用已部署的 onUserSignIn 云函数来登记用户、签发 mongoId claim。
# 置为 false 时会退回到客户端直接查询 users 集合,而安全规则会拒绝该查询,
# 导致登录异常。保持 "true" 即可。
VITE_FUNCTIONS_ENABLED = "true"

# Google Maps JavaScript API key —— 街景页 (/streetview) 的底图用。复用 aladdin2
# 那把浏览器 key(受 HTTP-referrer 限制,随前端公开、非机密);其 referrer 白名单
# 需含 ie.intofuture.org 与 localhost:5173。缺省时街景页会提示地图不可用。
VITE_MAPS_API_KEY = "AIzaSy..."
