rules_version = '2';

// Infrared Explorer — Firestore security rules
// Identity key is the legacy Mongo ObjectId, injected as the custom claim `mongoId`
// by the onUserSignIn Function. DEPLOY ORDER: deploy the Function first so existing
// sessions carry the claim, then deploy these rules. Before that, export the current
// live rules as a baseline (firebase firestore:rules — or the console) so you can
// roll back. See docs/telelab-migration.md §5.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    // The caller's Mongo ObjectId (null if the claim hasn't been minted yet).
    function mongoId() {
      return request.auth != null ? request.auth.token.mongoId : null;
    }
    function isOwner(ownerId) {
      return signedIn() && mongoId() == ownerId;
    }
    // Internal IFI staff, identified by sign-in email domain (no role/claim system here).
    // Grants the Admin screens (All Users / All Experiments) cross-owner, cross-visibility
    // reads. Mirrors src/utils/staff.ts. Read-only: staff get no write privileges from this.
    function isStaff() {
      return signedIn()
        && request.auth.token.email != null
        && request.auth.token.email.lower().matches('.*@intofuture[.]org');
    }

    // ---- experiments (merged: showcases + user clips) ----
    match /experiments/{expId} {
      allow read: if resource.data.visibility in ['public', 'unlisted']
                  || isOwner(resource.data.ownerId)
                  || isStaff();

      // Owners choose their experiment's visibility freely — including 'public', which puts it
      // on their profile page. The site homepage is curated separately via the staff-only
      // `featured` flag (Admin SDK / scripts/feature.mjs), which clients may never set.
      allow create: if isOwner(request.resource.data.ownerId)
                    && request.resource.data.ownerId != 'system'
                    && request.resource.data.get('featured', false) == false
                    && request.resource.data.ratingSum == 0
                    && request.resource.data.ratingCount == 0
                    && request.resource.data.viewCount == 0
                    && request.resource.data.commentCount == 0;

      // Owner may edit, but NOT mutate ownerId or the Function-maintained aggregates. Expressed
      // as "none of the protected keys may be added/removed/changed" via diff().affectedKeys()
      // rather than per-field equality: migrated user experiments predate `commentCount` (and
      // could lack other aggregates), and reading an absent field errors out, which would wrongly
      // deny every edit (analysis auto-save, rename, trash, description) on those docs.
      // The homepage `featured` flag is normally staff-curated (Admin SDK / scripts/feature.mjs)
      // and frozen against ordinary owner FEATURING — EXCEPT that a staff member may feature their
      // OWN experiments from the UI. A featured experiment must be public (the homepage query
      // requires it), so a write that leaves featured==true is staff-only AND requires the result
      // be public. Turning featured OFF is open to every owner: demoting a featured experiment
      // below Public clears the flag in the same write (whoever curated it), keeping the
      // "featured ⇒ public" invariant instead of stranding a lit flag on a private doc.
      // Owner edits. Protected: the Function-maintained aggregates, ownerId, the AI report fields, AND
      // the staff takedown fields (an owner can't clear their own takedown). A staff takedown also can't
      // be *restored* by the owner: while `trashedByStaff` is set, the owner's write must keep
      // trash==true (they may still hard-delete it via `allow delete`, a stronger removal — that's fine).
      //
      // The aiReport* fields are written ONLY by the generateLabReport Function (Admin SDK, which
      // bypasses these rules). They are provenance-bearing — the report is shown to every viewer as
      // machine-generated and stamped with the model that wrote it — so the owner must not be able to
      // hand-edit a number the AI got wrong, or paste their own prose in and have it read as AI-generated.
      // aiReportInstructions is locked for the same reason from the other direction: it records the notes
      // the owner gave the model, so a report cannot be privately steered and then shown as unguided.
      // No client code path writes them (see saveAnalysis / cloneExperimentById), so this locks nothing out.
      allow update: if isOwner(resource.data.ownerId)
                    && !request.resource.data.diff(resource.data).affectedKeys()
                         .hasAny(['ownerId', 'ratingSum', 'ratingCount', 'viewCount', 'commentCount',
                                  'aiReport', 'aiReportModel', 'aiReportAt', 'aiReportInstructions',
                                  'aiReportInputsHash', 'aiReportVerified', 'aiReportInputs', 'aiReportVision',
                                  'trashedByStaff', 'takedownReason', 'takedownAt', 'takedownBy'])
                    && (resource.data.get('trashedByStaff', false) == false
                        || request.resource.data.get('trash', false) == true)
                    && (
                         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['featured'])
                         // Any owner may clear featured (`== false` also matches an absent field via
                         // the default, and a non-bool value matches neither branch, so `is bool` is
                         // implied). Featuring stays staff-only and requires the result be public.
                         || request.resource.data.get('featured', false) == false
                         || (isStaff()
                             && request.resource.data.get('featured', false) == true
                             && request.resource.data.visibility == 'public')
                       );

      // Staff governance (the in-page Curate mode + takedowns): a staff member may curate / take down
      // ANY experiment — not just their own — but only these flags, nothing else (hasOnly), so this
      // grants no other edit power over others' content:
      //   • featured    — homepage curation. Featuring requires the experiment already be PUBLIC
      //                    (resource.data, not request): staff never flip someone else's visibility.
      //   • trash + trashedByStaff (+ takedownReason/At/By) — a takedown. `trashedByStaff` must ride
      //                    with trash==true; it's what stops the owner un-trashing it (see above).
      allow update: if isStaff()
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['featured', 'trash', 'trashedByStaff', 'takedownReason', 'takedownAt', 'takedownBy'])
                    && request.resource.data.get('featured', false) is bool
                    && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['featured'])
                        || request.resource.data.get('featured', false) == false
                        || resource.data.visibility == 'public')
                    && (request.resource.data.get('trashedByStaff', false) == false
                        || request.resource.data.get('trash', false) == true);

      allow delete: if isOwner(resource.data.ownerId);

      // Sub-docs carry redundant ownerId/visibility because list rules cannot get() the parent.
      match /thermometers/{id} {
        allow read: if resource.data.visibility in ['public', 'unlisted']
                    || isOwner(resource.data.ownerId);
        // create/update use request.resource; delete uses resource (request.resource is null).
        allow create, update: if isOwner(request.resource.data.ownerId);
        allow delete: if isOwner(resource.data.ownerId);
      }

      match /annotations/{id} {
        allow read: if resource.data.visibility in ['public', 'unlisted']
                    || isOwner(resource.data.ownerId);
        allow create, update: if isOwner(request.resource.data.ownerId);
        allow delete: if isOwner(resource.data.ownerId);
      }

      // AI Q&A history — one doc per answered question, tagged with the asker's userId. Written ONLY by
      // the answerExperimentQuestion Function (Admin SDK bypasses these rules). Private per user: a user
      // reads (and may clear) only their OWN turns; the load query must filter userId == mongoId.
      match /qaTurns/{turnId} {
        allow read:   if signedIn() && resource.data.userId == mongoId();
        allow delete: if signedIn() && resource.data.userId == mongoId();
        allow create, update: if false;
      }

      // Cached derived analysis (experiments/{expId}/derived/analysis): the numeric summary and the
      // fits computed from it, keyed by a fingerprint of the inputs that produced them. Purely a cache
      // of Function-computed values — a client that could write it could feed fabricated numbers to
      // every AI surface at once. Unmatched paths are denied by default; this block is here so the
      // intent is written down rather than inferred. Cleaned up by the doc's recursiveDelete cascade.
      match /derived/{docId} {
        allow read, write: if false;
      }

      match /comments/{id} {
        allow read: if true;
        allow create: if signedIn()
                      && request.resource.data.senderId == mongoId()
                      && request.resource.data.content is string
                      && request.resource.data.content.size() <= 2000
                      && request.resource.data.keys().hasOnly(
                           ['senderId', 'senderName', 'senderAvatar', 'content', 'date', 'replyTo']);
        // Author-only edit: may change ONLY `content` (identity/threading fields are
        // pinned, so a comment can't be reassigned to another user), re-validated for
        // type/size like create. Matches updateComment(), which writes just { content }.
        allow update: if signedIn()
                      && resource.data.senderId == mongoId()
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['content'])
                      && request.resource.data.content is string
                      && request.resource.data.content.size() <= 2000;
        // Author-only delete; a Function cascades to replies (Admin SDK bypasses rules).
        allow delete: if signedIn() && resource.data.senderId == mongoId();
      }

      match /ratings/{ratingId} {
        allow read: if true;
        // One-time, immutable rating per user (docId == mongoId): CREATE only — no update, no
        // delete — so a rating can't be changed or withdrawn once cast. (Admin-SDK cleanup scripts
        // bypass these rules, so removing bad data is still possible out-of-band.) Owners may NOT
        // rate their own experiment: the client hides the control, and this get() on the parent
        // enforces it server-side. A get() is fine here — this is a single-doc write, not a list
        // query (unlike the sub-doc rules above, which duplicate ownerId precisely because list
        // rules can't get() the parent). Ratings are infrequent, so the extra read is cheap.
        // Showcases (ownerId 'system') have no human owner to self-rate, so mongoId() != 'system'
        // lets anyone signed in rate them.
        allow create: if signedIn()
                      && ratingId == mongoId()
                      && get(/databases/$(database)/documents/experiments/$(expId)).data.ownerId != mongoId()
                      && request.resource.data.rating is int
                      && request.resource.data.rating >= 1
                      && request.resource.data.rating <= 5
                      && request.resource.data.keys().hasOnly(['rating']);
      }
    }

    // ---- streetviews (crowd-sourced geo-tagged thermal panoramas) ----
    // Captured by the mobile app (infrared-explorer-app) Street View Maker and
    // browsed on the /isv-style map. Mirrors experiments' visibility model, but
    // with a stricter create: the client may only mint PRIVATE/UNLISTED — PUBLIC
    // (map-visible) is a staff curation promotion, never a client write. The map's
    // anonymous list query is `visibility == 'public' && trash == false`, which
    // the public/unlisted read clause authorizes. See the app repo:
    // docs/proposals/infrared-street-view.md §8 and docs/DECISIONS.md.
    match /streetviews/{svId} {
      allow read: if resource.data.visibility in ['public', 'unlisted']
                  || isOwner(resource.data.ownerId)
                  || isStaff();

      // Create-only for the owner. Visibility is owner-chosen — INCLUDING 'public',
      // which puts the panorama on the crowd-sourced map (that's the whole point of
      // Street View: browse others' captures). Parity with the experiments create
      // (owners choose visibility freely); aggregates must start at 0. Moderation is
      // by staff takedown below, not a pre-publication gate.
      allow create: if isOwner(request.resource.data.ownerId)
                    && request.resource.data.ownerId != 'system'
                    && request.resource.data.visibility in ['private', 'unlisted', 'public']
                    && request.resource.data.ratingSum == 0
                    && request.resource.data.ratingCount == 0
                    && request.resource.data.viewCount == 0
                    && request.resource.data.commentCount == 0;

      // Owner edits: may change visibility freely (publish / unlist / hide), but may
      // NOT touch ownerId, the Function-maintained aggregates, or the staff-takedown
      // fields. While a staff takedown is set, the owner's write must keep
      // trash == true. diff()-based for forward compatibility with new fields.
      allow update: if isOwner(resource.data.ownerId)
                    && !request.resource.data.diff(resource.data).affectedKeys()
                         .hasAny(['ownerId', 'ratingSum', 'ratingCount', 'viewCount', 'commentCount',
                                  'trashedByStaff', 'takedownReason', 'takedownAt', 'takedownBy'])
                    && (resource.data.get('trashedByStaff', false) == false
                        || request.resource.data.get('trash', false) == true);

      // Staff moderation / takedown: ONLY these flags (hasOnly), so staff get no
      // other edit power over a user's street view. `trashedByStaff` must ride with
      // trash == true (what stops the owner un-trashing it); staff may also force a
      // visibility change (e.g. unpublish an inappropriate capture).
      allow update: if isStaff()
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['visibility', 'trash', 'trashedByStaff',
                                   'takedownReason', 'takedownAt', 'takedownBy'])
                    && (request.resource.data.get('trashedByStaff', false) == false
                        || request.resource.data.get('trash', false) == true);

      allow delete: if isOwner(resource.data.ownerId);
    }

    // ---- collection-group read: the settings profile card's "Comments" count ----
    // The nested experiments/{expId}/comments rule governs per-experiment reads but does
    // NOT authorize collectionGroup('comments') queries. This recursive-wildcard rule does
    // — and ONLY for a query constrained to the caller's own comments (senderId == mongoId),
    // so the whole comments corpus stays un-enumerable. getUserStats() filters on senderId,
    // which lets Firestore prove the constraint holds for every matched doc. Direct
    // per-experiment reads are unaffected: the nested `read: if true` still OR-wins there.
    match /{path=**}/comments/{commentId} {
      allow read: if isOwner(resource.data.senderId) || isStaff();
    }

    // ---- collection-group read: a student's own class memberships ----
    // Authorizes collectionGroup('members') queries constrained to uid == mongoId, so the
    // "my classes" list can find joined classes directly from the membership docs (the source
    // of truth) without relying on the denormalized users/{uid}.joinedClasses array. Per-class
    // roster reads are unaffected — the nested classes/{id}/members rule governs those.
    match /{path=**}/members/{memberId} {
      allow read: if signedIn() && resource.data.uid == mongoId();
    }

    // ---- private user profile (email / prefs / role) ----
    match /users/{userId} {
      // Owner reads/writes their own profile; staff get read-only access for the Admin user list.
      allow read: if isOwner(userId) || isStaff();
      allow write: if isOwner(userId);

      match /history/{expId} {
        allow read, write: if isOwner(userId);
      }

      // Notifications are written by Functions (Admin SDK bypasses rules).
      // Client may only read its own and flip `read` to true.
      match /notifications/{id} {
        allow read: if isOwner(userId);
        allow update: if isOwner(userId)
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
                      && request.resource.data.read is bool;
        allow create, delete: if false;
      }
    }

    // ---- public profile slice (displayName / avatar / bio / joined date) ----
    // World-readable: it feeds the public profile page (/users/:id) for any visitor, signed
    // out included. Owner-writable, but only the public-safe fields with sane sizes — there
    // is no other validation layer between the client and this doc. Note merge writes are
    // validated against the MERGED result, so extra legacy keys would deny the write.
    // `createdAt` (the profile's "Joined" date) is normally stamped by onUserSignIn / the
    // backfill script (Admin SDK), but may ride along on client merge writes. Delete stays
    // denied so a once-created profile doc can't vanish out from under the page.
    match /usersPublic/{userId} {
      // Nulls are tolerated because merge writes validate the MERGED doc, and Admin-SDK writers
      // (onUserSignIn, the migration) store `displayName: null` / `avatar: null` when Google
      // provides none — a strict `is string` would then deny every later client save.
      function publicProfileFieldsValid() {
        return request.resource.data.keys().hasOnly(['displayName', 'avatar', 'bio', 'createdAt', 'pinned'])
          && (!('displayName' in request.resource.data)
              || request.resource.data.displayName == null
              || (request.resource.data.displayName is string
                  && request.resource.data.displayName.size() <= 120))
          && (!('avatar' in request.resource.data)
              || request.resource.data.avatar == null
              || (request.resource.data.avatar is string
                  && request.resource.data.avatar.size() <= 2048))
          && (!('bio' in request.resource.data)
              || request.resource.data.bio == null
              || (request.resource.data.bio is string
                  && request.resource.data.bio.size() <= 500))
          // Owner-chosen experiment ids pinned to the top of the profile gallery. A small ordered
          // list; the page only renders pins that resolve to one of the owner's public experiments,
          // so a stale/private id just doesn't show. Cap the size — a public doc has no other guard.
          && (!('pinned' in request.resource.data)
              || request.resource.data.pinned == null
              || (request.resource.data.pinned is list
                  && request.resource.data.pinned.size() <= 3));
      }

      allow read: if true;
      // `createdAt` (the profile's "Joined" date) is Admin-SDK-stamped (onUserSignIn / the
      // backfill) and PINNED so owners can't forge how long they've been around: clients may
      // not set it at create nor change it on update. Merge writes validate the merged doc,
      // so the existing value riding along still passes the equality pin.
      allow create: if isOwner(userId)
        && publicProfileFieldsValid()
        && !('createdAt' in request.resource.data);
      allow update: if isOwner(userId)
        && publicProfileFieldsValid()
        && request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null);
    }

    // ---- site config (e.g. config/homepage = ordered list of hero experiment ids) ----
    // Public read so anyone can render the curated homepage.
    match /config/{docId} {
      allow read: if true;
      allow write: if false;
    }
    // config/homepage = { heroIds: [expId, …] } — the ordered hero board, written from the in-page
    // staff Curate mode. Overlaps the wildcard above; rule allows are OR'd, so staff writes here are
    // permitted while every other config doc stays Admin-SDK-only. Capped at 5 ids (the hero size);
    // ids reference public featured experiments (the homepage resolves + drops any that no longer
    // qualify), so no cross-doc validation is needed here.
    match /config/homepage {
      allow read: if true;
      allow write: if isStaff()
                   && request.resource.data.heroIds is list
                   && request.resource.data.heroIds.size() <= 5;
    }

    // ---- transition: authUid -> mongoId map, written by onUserSignIn (Admin SDK) ----
    match /uidMap/{authUid} {
      allow read: if request.auth != null && request.auth.uid == authUid;
      allow write: if false;
    }

    // ---- contact-us messages ----
    // Clients no longer write here directly: submissions go through the submitContactMessage
    // callable (per-IP rate limit), which writes via the Admin SDK and bypasses
    // these rules. Reading is done by the admin via the console.
    match /contactMessages/{id} {
      allow read, write: if false;
    }

    // ---- per-IP rate-limit counters for the contact form (server-managed only) ----
    match /contactRateLimits/{ipHash} {
      allow read, write: if false;
    }

    // ---- per-(IP, experiment) view-count rate limits, managed by the recordView callable ----
    // (Docs carry `expireAt` for a Firestore TTL policy; see the function's docstring.)
    match /viewRateLimits/{id} {
      allow read, write: if false;
    }

    // ---- client crash reports (written by the crash page; see src/services/errorLog.ts) ----
    // CREATE-only and open to everyone, signed-out included — a crash can precede any auth
    // state, and the report must still get out. The open write is bounded by an exact key
    // set + per-field type/size caps (mirrored client-side), so it can't be abused as
    // free-form storage. Never client-readable: the team reads via the console / Admin SDK.
    // Docs carry `expireAt` for a Firestore TTL policy (~90 days; capped at 91d here so junk
    // can't be pinned far into the future), same mechanism as viewRateLimits. Enable once:
    //   gcloud firestore fields ttls update expireAt --collection-group=errorLogs --enable-ttl
    match /errorLogs/{id} {
      allow read, update, delete: if false;
      allow create: if request.resource.data.keys().hasOnly(
                         ['message', 'stack', 'componentStack', 'url', 'userAgent',
                          'appVersion', 'env', 'userId', 'createdAt', 'expireAt'])
                    && request.resource.data.message is string
                    && request.resource.data.message.size() <= 2000
                    && request.resource.data.stack is string
                    && request.resource.data.stack.size() <= 20000
                    && (request.resource.data.componentStack == null
                        || (request.resource.data.componentStack is string
                            && request.resource.data.componentStack.size() <= 20000))
                    && request.resource.data.url is string
                    && request.resource.data.url.size() <= 2048
                    && request.resource.data.userAgent is string
                    && request.resource.data.userAgent.size() <= 1024
                    && request.resource.data.appVersion is string
                    && request.resource.data.appVersion.size() <= 32
                    && request.resource.data.env is string
                    && request.resource.data.env.size() <= 32
                    && (request.resource.data.userId == null
                        || (request.resource.data.userId is string
                            && request.resource.data.userId.size() <= 64))
                    && request.resource.data.createdAt is timestamp
                    && request.resource.data.expireAt is timestamp
                    && request.resource.data.expireAt <= request.time + duration.value(91, 'd');
    }

    // ---- classroom (v1) — see docs/classroom-design-zh.md ----
    // Teacher = whoever created the class (teacherUid). Joining is done by the joinClass
    // callable (password check + rate limit), so client-side member/class CREATE is denied.
    match /classes/{classId} {
      // For subcollection rules there is no `resource` for the parent class, so they must
      // get() it. The class doc's OWN rules use resource.data directly (a pure-field check),
      // so the `where teacherUid == me` list query is authorizable without get()/exists().
      function classData() { return get(/databases/$(database)/documents/classes/$(classId)).data; }
      function isClassTeacher() { return signedIn() && classData().teacherUid == mongoId(); }
      function isMember()  {
        return signedIn()
          && exists(/databases/$(database)/documents/classes/$(classId)/members/$(mongoId()));
      }

      allow read:   if signedIn() && (resource.data.teacherUid == mongoId() || isMember());
      allow create: if false; // via createClass callable (needs server-side password hashing)
      // Teacher may edit metadata, but not transfer ownership or touch the trigger-maintained count.
      allow update: if signedIn()
                    && resource.data.teacherUid == mongoId()
                    && request.resource.data.teacherUid == resource.data.teacherUid
                    && request.resource.data.memberCount == resource.data.memberCount;
      allow delete: if signedIn() && resource.data.teacherUid == mongoId();

      match /members/{studentUid} {
        allow read:   if isMember() || isClassTeacher();
        allow create: if false;  // via joinClass callable
        allow update: if false;  // counts maintained by a trigger
        allow delete: if isClassTeacher() || (signedIn() && studentUid == mongoId()); // remove / leave
      }

      match /assignments/{aId} {
        allow read: if isMember() || isClassTeacher();
        allow create, update, delete: if isClassTeacher();

        match /submissions/{studentUid} {
          allow read:   if isClassTeacher() || (signedIn() && studentUid == mongoId());
          allow create, update: if signedIn() && studentUid == mongoId() && isMember()
                                && request.resource.data.studentUid == studentUid;
          allow delete: if isClassTeacher() || (signedIn() && studentUid == mongoId());
        }

        match /grades/{studentUid} {
          allow read:  if isClassTeacher() || (signedIn() && studentUid == mongoId());
          allow write: if isClassTeacher();
        }
      }

      match /showcase/{itemId} {
        allow read:  if isMember() || isClassTeacher();
        allow write: if isClassTeacher(); // student work is promoted via the promoteToShowcase callable
      }

      match /announcements/{id} {
        allow read:  if isMember() || isClassTeacher();
        allow write: if isClassTeacher();
      }

      // Per-student private workspace: their own working copies for this class. Only the
      // student reads/writes their own items; the teacher does not see the workspace.
      match /workspace/{itemId} {
        allow read:   if signedIn() && resource.data.studentUid == mongoId();
        allow create: if signedIn() && isMember() && request.resource.data.studentUid == mongoId();
        allow update, delete: if signedIn() && resource.data.studentUid == mongoId();
      }
    }

    // Class join password (plaintext). Readable only by the class's teacher so they can view
    // it on their own page; written only via the createClass / changeClassPassword callables.
    match /classSecrets/{classId} {
      allow read: if signedIn()
                  && get(/databases/$(database)/documents/classes/$(classId)).data.teacherUid == mongoId();
      allow write: if false;
    }
    // Function-managed only (Admin SDK bypasses these denials).
    match /classNumbers/{number}     { allow read, write: if false; }
    match /classJoinRateLimits/{uid} { allow read, write: if false; }
  }
}
