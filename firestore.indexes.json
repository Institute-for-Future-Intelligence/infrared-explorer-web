{
  "indexes": [
    {
      "_comment": "My Experiments / Trash: where ownerId == me && trash == ? orderBy updatedAt desc",
      "collectionGroup": "experiments",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "ownerId", "order": "ASCENDING" },
        { "fieldPath": "trash", "order": "ASCENDING" },
        { "fieldPath": "updatedAt", "order": "DESCENDING" }
      ]
    },
    {
      "_comment": "Recent: where visibility == 'public' && trash == false orderBy createdAt desc",
      "collectionGroup": "experiments",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "visibility", "order": "ASCENDING" },
        { "fieldPath": "trash", "order": "ASCENDING" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    },
    {
      "_comment": "Showcase home: where sourceType == 'video' && ownerId == 'system' orderBy createdAt desc",
      "collectionGroup": "experiments",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "sourceType", "order": "ASCENDING" },
        { "fieldPath": "ownerId", "order": "ASCENDING" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    },
    {
      "_comment": "Related: where recordingId == X && visibility in [public,unlisted]",
      "collectionGroup": "experiments",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "recordingId", "order": "ASCENDING" },
        { "fieldPath": "visibility", "order": "ASCENDING" }
      ]
    },
    {
      "_comment": "Raw: where ownerId == me && isRaw == true (isRaw boolean mirrors segments==null, since composite indexes can't equality-match an array field)",
      "collectionGroup": "experiments",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "ownerId", "order": "ASCENDING" },
        { "fieldPath": "isRaw", "order": "ASCENDING" }
      ]
    }
  ],
  "fieldOverrides": [
    {
      "_comment": "Settings profile card: count comments authored by me across all experiments (collectionGroup query on senderId)",
      "collectionGroup": "comments",
      "fieldPath": "senderId",
      "indexes": [
        { "order": "ASCENDING", "queryScope": "COLLECTION" },
        { "order": "ASCENDING", "queryScope": "COLLECTION_GROUP" }
      ]
    }
  ]
}
